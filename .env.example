PORT=3030
FRONTEND_ORIGIN=http://localhost:3031
DATABASE_URL=postgres://YOUR_MAC_USERNAME@localhost:5432/iorio_reloaded_development
TEST_DATABASE_URL=postgres://YOUR_MAC_USERNAME@localhost:5432/iorio_reloaded_test

# IBKR connectivity (Gateway runs on the VPS, reached via a restricted SSH tunnel)
IBKR_TRADING_MODE=paper
IBKR_TUNNEL_SSH_HOST=142.132.185.128
IBKR_TUNNEL_SSH_PORT=22
IBKR_TUNNEL_SSH_USERNAME=root
# base64 of the tunnel-only private key (~/.ssh/iorio_ibkr_tunnel), e.g. `base64 -i ~/.ssh/iorio_ibkr_tunnel`
IBKR_TUNNEL_SSH_PRIVATE_KEY_BASE64=
IBKR_GATEWAY_HOST=127.0.0.1

# IBKR Flex Web Service (separate from the Gateway connection above) — only
# used by the daily P&L snapshot job to detect deposits/withdrawals via the
# "Cash Transactions" section of an Activity Flex Query. Set up in Client
# Portal (paper account login) under Reports > Flex Queries + Settings >
# Flex Web Service. See fetchFlexCashTransactions.ts for details.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
