PORT=3030
FRONTEND_ORIGIN=http://localhost:3031
DATABASE_URL=postgres://YOUR_MAC_USERNAME@localhost:5432/iorio_reloaded_development
TEST_DATABASE_URL=postgres://YOUR_MAC_USERNAME@localhost:5432/iorio_reloaded_test

# IBKR connectivity (Gateway runs on the VPS, reached via a restricted SSH tunnel)
IBKR_TRADING_MODE=paper
# development | staging | production — read by the worker, recorded in worker_health
APP_ENVIRONMENT=development
# Exactly one IBKR account id this environment may trade against (worker refuses to trade/sync otherwise)
IBKR_EXPECTED_ACCOUNT_ID=DUR000000
IBKR_TUNNEL_SSH_HOST=142.132.185.128
IBKR_TUNNEL_SSH_PORT=22
IBKR_TUNNEL_SSH_USERNAME=root
# base64 of the tunnel-only private key (~/.ssh/iorio_ibkr_tunnel), e.g. `base64 -i ~/.ssh/iorio_ibkr_tunnel`
IBKR_TUNNEL_SSH_PRIVATE_KEY_BASE64=
IBKR_GATEWAY_HOST=127.0.0.1
# "true" lets this process open IBKR market-data lines (live quotes, option chains, the Day Signals
# loop, the chain capture) through the shared line budget; "false" refuses every reservation with a
# clear message. Keep "false" in local dev unless testing a live screen: dev and staging share one
# IBKR login (100 lines total) but not a reservation table. Required.
IBKR_MARKET_DATA_LINES_ENABLED=false

# IBKR Flex Web Service (separate from the Gateway connection above) — only
# used by the daily P&L snapshot job to detect deposits/withdrawals via the
# "Cash Transactions" section of an Activity Flex Query. Set up in Client
# Portal (paper account login) under Reports > Flex Queries + Settings >
# Flex Web Service. See fetchFlexCashTransactions.ts for details.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# Telegram notifications (src/lib/notifyTelegram.ts). Set TELEGRAM_NOTIFICATIONS_DISABLED=true
# in local dev so crashes/jobs never alert the ops channel; leave unset in Heroku and on the VPS worker.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_DISABLED=

# Nightly expiry-settlement audit (scripts/run-daily-expiry-settlement-audit-job.ts): "dry_run" logs/notifies what it would
# change; "apply" writes the corrections. Required.
EXPIRY_SETTLEMENT_MODE=

# Day Signals intraday refresh loop (src/lib/daySignalsLoop.ts): "true" runs it in this web process
# (10 IBKR market-data lines while the market is open). Required; keep "false" in local dev unless you
# are testing it — local dev and staging share the same IBKR login.
DAY_SIGNALS_LOOP_ENABLED=false

# Iorio Pulse Database node: the Heroku Postgres plan's storage limit in bytes (Postgres cannot report it; Essential-1 = 10 GiB = 10737418240). Read by GET /system-health/db only. Required.
DB_PLAN_MAX_SIZE_BYTES=10737418240
