{
  "name": "iorio-reloaded-api",
  "version": "1.0.0",
  "private": true,
  "description": "Iorio Reloaded backend API",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "migrate:latest": "tsx node_modules/.bin/knex migrate:latest --knexfile src/db/knexfile.ts",
    "migrate:latest:prod": "node node_modules/.bin/knex migrate:latest --knexfile dist/src/db/knexfile.js",
    "migrate:rollback": "tsx node_modules/.bin/knex migrate:rollback --knexfile src/db/knexfile.ts",
    "migrate:status": "tsx node_modules/.bin/knex migrate:status --knexfile src/db/knexfile.ts",
    "migrate:make": "tsx node_modules/.bin/knex migrate:make --knexfile src/db/knexfile.ts -x ts",
    "test": "vitest run",
    "manage-user": "tsx scripts/manage-user.ts",
    "capture-screener-snapshot": "tsx scripts/capture-screener-snapshot.ts"
  },
  "dependencies": {
    "@stoqey/ib": "^1.6.6",
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/ssh2": "^1.15.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true
  }
}
